# Copy to .env for local dev. On Railway, set these as service Variables instead —
# never commit a filled-in .env.

PORT=4000
NODE_ENV=production
API_BASE_URL=https://your-backend-service.up.railway.app

# WhatsApp Cloud API — leave WHATSAPP_MOCK_MODE=true until real credentials are ready
WHATSAPP_MOCK_MODE=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0

# LLM / OCR — leave blank to skip AI-assisted extraction (manual data entry still works)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OCR_PROVIDER=tesseract

# Security — generate real random values for these before deploying anywhere
# shared; the defaults in src/config/env.js are dev-only placeholders.
JWT_SECRET=
EXTENSION_API_KEY=
MAX_FILE_SIZE_BYTES=10485760
DOCUMENT_STORAGE_DIR=./uploads/documents
